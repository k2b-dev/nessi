{
  "name": "@k2b/nessi",
  "version": "0.6.0",
  "description": "Minimal agent loop and provider adapters for nessi.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai/index.ts",
    "./ai/providers/openai-compatible-transcription": "./src/ai/providers/openai-compatible-transcription.ts",
    "./ai/providers/vllm-realtime-transcription": "./src/ai/providers/vllm-realtime-transcription.ts",
    "./ai/providers/systemone-decision": "./src/ai/providers/systemone-decision.ts",
    "./ai/providers/cloudflare-decision": "./src/ai/providers/cloudflare-decision.ts",
    "./ai/providers/openai-compatible": "./src/ai/providers/openai-compatible.ts"
  },
  "scripts": {
    "build:npm": "rm -rf dist && tsc --project tsconfig.json && node ../../scripts/prepare-nessi-publish.mjs",
    "test": "bun test",
    "test:ai": "bun test tests/ai",
    "test:core": "bun test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "zod": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
