{
  "name": "nessi-monorepo",
  "description": "Minimal agent loop and provider adapters for nessi.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "bun run --filter @k2b/nessi typecheck",
    "test": "bun run --filter @k2b/nessi test",
    "test:ai": "bun run --filter @k2b/nessi test:ai",
    "test:core": "bun run --filter @k2b/nessi test:core",
    "build:nessi": "bun run --filter @k2b/nessi build:npm"
  }
}
